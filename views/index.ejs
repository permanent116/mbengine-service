<!-- Call to Action -->
<section class="py-20 bg-gradient-to-r from-gray-900 to-black">
  <div class="container mx-auto px-4 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">Нужна диагностика?</h2>
      <p class="text-xl text-gray-300 mb-8">Оставьте заявку и мы свяжемся с вами в ближайшее время</p>
      
      <form id="quickOrderForm" class="max-w-md mx-auto">
          <div class="mb-4">
              <input type="text" id="name" placeholder="Ваше имя" required inputmode="numeric" class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg focus:outline-none focus:border-gold-accent">
          </div>
           <div>
    <label for="phone" class="block text-sm font-medium mb-2">Телефон</label>
    <input type="tel" id="phone" name="phone" required
           autocomplete="tel"
           inputmode="numeric"
           autocorrect="off"
           autocomplete="off"
           spellcheck="false"
           placeholder="+7 (___) ___-__-__"
           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-gold-accent transition min-w-[250px]">
</div>
          <button type="submit" class="w-full gold-bg text-white px-6 py-3 rounded-lg font-semibold hover:bg-amber-700 transition">
              Отправить заявку
          </button>
          
          <!-- Loading Spinner (hidden by default) -->
          <div id="loadingSpinner" class="hidden mt-4 p-4 bg-gray-700 border border-gray-600 rounded-lg text-center">
              <i class="fas fa-spinner fa-spin text-white mr-2"></i>
              <span class="text-white">Отправка заявки...</span>
          </div>
          
          <!-- Success Message (hidden by default) -->
          <div id="successMessage" class="hidden mt-4 p-4 bg-green-900/50 border border-green-700 rounded-lg text-center">
              <i class="fas fa-check-circle text-green-400 mr-2"></i>
              <span class="text-green-200">Заявка успешно отправлена! Мы свяжемся с вами в ближайшее время.</span>
          </div>
          
          <!-- Error Message (hidden by default) -->
          <div id="errorMessage" class="hidden mt-4 p-4 bg-red-900/50 border border-red-700 rounded-lg text-center">
              <i class="fas fa-exclamation-circle text-red-400 mr-2"></i>
              <span class="text-red-200" id="errorMessageText"></span>
          </div>
      </form>
       <p class="text-xs text-gray-500 mt-4">Нажимая на кнопку, вы соглашаетесь с политикой обработки данных</p>
    </div>
