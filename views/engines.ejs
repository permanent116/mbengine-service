<div class="container mx-auto px-4 py-20">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 gold-accent">Продажа двигателей Mercedes-Benz на обмен</h2>
    
    <!-- Карточка продажи двигателей -->
    <div class="bg-gray-800 rounded-xl p-8 text-center card-hover mb-16">
        <div class="text-5xl gold-accent mb-4">
            <i class="fas fa-exchange-alt"></i>
        </div>
        <h3 class="text-2xl font-bold mb-4">Откапиталенные моторы Mercedes-Benz в наличии</h3>
        <p class="text-gray-300 mb-4">Принимаем ваш двигатель в зачёт стоимости. Полный цикл восстановления: блок цилиндров (расточка/гильзовка), поршневая группа, ГБЦ, ГРМ (цепь, звезды, натяжитель), масляный насос, все прокладки и уплотнения. Обкатка и контроль качества перед установкой.</p>
        <p class="text-gray-400 mb-2">Условия: бесплатная дефектовка вашего мотора, прозрачная оценка, замена под ключ за 1-3 дня. Гарантия до 12 месяцев.</p>
        <p class="text-3xl font-bold gold-accent my-4">от 178 000 ₽</p>
        <a href="/contacts" class="inline-block bg-gold-bg text-white px-8 py-3 rounded-full hover:bg-amber-700 transition font-semibold">Записаться на оценку</a>
    </div>

    <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 gold-accent mt-16">Двигатели Mercedes-Benz в наличии</h2>
    
    <% if (engines && engines.length > 0) { %>
        <div class="grid md:grid-cols-3 gap-8">
            <% engines.forEach(function(engine) { %>
                <div class="bg-gray-800 rounded-xl p-6 text-center card-hover">
                    <h3 class="text-xl font-bold mb-3"><%= engine.name %></h3>
                    <p class="text-gray-400 mb-2"><%= engine.type %></p>
                    <p class="text-gray-500 text-sm mb-2"><i class="fas fa-calendar"></i> <%= engine.years %></p>
                    <p class="text-gray-400 mb-4"><%= engine.description %></p>
                    
                    <% if (engine.models && engine.models.length > 0) { %>
                        <div class="flex flex-wrap justify-center gap-2 mb-4">
                            <% engine.models.forEach(function(model) { %>
                                <span class="bg-gold-bg text-white px-3 py-1 rounded-full text-sm"><%= model %></span>
                            <% }) %>
                        </div>
                    <% } %>
                    
                    <% if (engine.photo) { %>
                        <img src="<%= engine.photo %>" alt="<%= engine.name %>" class="w-full h-48 object-cover rounded-lg mb-3">
                    <% } else { %>
                        <div class="bg-gray-700 h-48 rounded-lg mb-3 flex items-center justify-center">
                            <span class="text-gray-500 text-sm">Фото отсутствует</span>
                        </div>
                    <% } %>
                    
                    <a href="/contacts" class="inline-block border border-gold-accent text-gold-accent px-6 py-2 rounded-full hover:gold-bg hover:text-white transition">Записаться</a>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <p class="text-center text-muted">Данные двигателей не загружены</p>
    <% } %>
</div>
