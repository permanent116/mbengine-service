<!-- Contacts Section -->
<section class="py-20 bg-gray-900">
    <div class="container mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-4">Контакты</h2>
        <p class="text-center text-gray-400 mb-12">Свяжитесь с нами для записи на диагностику или консультацию</p>
        
        <div class="grid md:grid-cols-2 gap-12 items-center">
            <!-- Contact Info -->
            <div>
                <div class="space-y-8">
                    <div class="flex items-start space-x-4">
                        <div class="gold-bg p-3 rounded-full">
                            <i class="fas fa-phone text-xl"></i>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold mb-1">Телефон</h3>
                            <p class="text-gray-400">+7 (926) 933-32-68</p>
                            <p class="text-sm text-gray-500 mt-1">Пн-Пт: 09:00-20:00, Сб: 10:00-17:00</p>
                        </div>
                    </div>

                    <div class="flex items-start space-x-4">
                        <div class="gold-bg p-3 rounded-full">
                            <i class="fas fa-envelope text-xl"></i>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold mb-1">Email</h3>
                            <p class="text-gray-400">mbengine.workshop@yandex.ru</p>
                        </div>
                    </div>

                    <div class="flex items-start space-x-4">
                        <div class="gold-bg p-3 rounded-full">
                            <i class="fas fa-map-marker-alt text-xl"></i>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold mb-1">Адрес</h3>
                            <p class="text-gray-400">г. Москва, ул. Дорожная, д. 54к4с2</p>
                        </div>
                    </div>

                    <div class="flex items-start space-x-4">
                        <div class="gold-bg p-3 rounded-full">
                            <i class="fas fa-clock text-xl"></i>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold mb-1">Режим работы</h3>
                            <p class="text-gray-400">Пн-Пт: 09:00-20:00, Сб: 10:00-17:00, Вс: выходной</p>
                        </div>
                    </div>
                </div>

                <!-- Social Media -->
                <div class="mt-12">
                    <h3 class="text-lg font-bold mb-4">Мы в социальных сетях</h3>
                    <div class="flex space-x-4">
                        <a href="#" class="gold-bg p-3 rounded-full hover:bg-amber-700 transition">
                            <i class="fab fa-vk text-xl"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="bg-gray-800 rounded-xl p-8">
                <h3 class="text-2xl font-bold mb-6 text-center">Оставить заявку</h3>
                <form id="contactForm" class="space-y-4">
                    <input type="hidden" name="source" value="Контакты">
                    <div>
                        <label for="name" class="block text-sm font-medium mb-2">Ваше имя</label>
                        <input type="text" id="name" name="name" required
                               class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-gold-accent transition">
                    </div>

                    <div>
                        <label for="phone" class="block text-sm font-medium mb-2">Телефон</label>
                        <input type="tel" id="phone" name="phone" required
                               inputmode="text"
                               autocorrect="off"
                               autofill="off"
                               autocomplete="off"
                               spellcheck="false"
                               placeholder="+7 __________"
                               class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-3 text-white focus:outline-none focus:border-gold-accent transition min-w-[250px]">
                    </div>

                    <button type="submit"
                            class="w-full gold-bg text-white py-3 rounded-lg font-semibold hover:bg-amber-700 transition">
                        Отправить заявку
                    </button>
                </form>

                <!-- Loading Spinner (hidden by default) -->
                <div id="loadingSpinner" class="hidden mt-4 p-4 bg-gray-700 border border-gray-600 rounded-lg text-center">
                    <i class="fas fa-spinner fa-spin text-white mr-2"></i>
                    <span class="text-white">Отправка заявки...</span>
                </div>

                <!-- Success Message (hidden by default) -->
                <div id="successMessage" class="hidden mt-4 p-4 bg-green-900/50 border border-green-700 rounded-lg text-center">
                    <i class="fas fa-check-circle text-green-400 mr-2"></i>
                    <span class="text-green-200">Заявка успешно отправлена! Мы свяжемся с вами в ближайшее время.</span>
                </div>

                <!-- Error Message (hidden by default) -->
                <div id="errorMessage" class="hidden mt-4 p-4 bg-red-900/50 border border-red-700 rounded-lg text-center">
                    <i class="fas fa-exclamation-circle text-red-400 mr-2"></i>
                    <span class="text-red-200" id="errorMessageText"></span>
                </div>

                <!-- Form Script -->
                <script>
                    // Блокируем автодобавление +7 браузером
                    const phoneInput = document.getElementById('phone');
                    if (phoneInput) {
                        // Отменяем автоформатирование при любом вводе
                        phoneInput.addEventListener('input', function(e) {
                            // Удаляем +7 из начала значения
                            this.value = this.value.replace(/^\+7\s*/, '');
                            // Сбрасываем курсор в конец
                            this.setSelectionRange(this.value.length, this.value.length);
                        });
                        
                        // Отменяем автоформатирование при фокусе
                        phoneInput.addEventListener('focus', function() {
                            this.value = this.value.replace(/^\+7\s*/, '');
                            this.setSelectionRange(this.value.length, this.value.length);
                        });
                        
                        // Блокируем вставку через Ctrl+V
                        phoneInput.addEventListener('paste', function(e) {
                            e.preventDefault();
                            const clipboardData = (e.originalEvent || e).clipboardData.getData('text');
                            this.value = this.value.replace(/^\+7\s*/, '') + clipboardData;
                        });
                    }
                    
                    document.getElementById('contactForm').addEventListener('submit', async function(e) {
                        e.preventDefault();
                        
                        const formData = new FormData(this);
                        const name = formData.get('name');
                        const phone = formData.get('phone');
                        
                        // Show loading
                        this.classList.add('hidden');
                        document.getElementById('loadingSpinner').classList.remove('hidden');
                        
                        try {
                            const response = await fetch('/api/order', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({
                                    name: name,
                                    phone: phone,
                                    source: 'Контакты'
                                })
                            });
                            
                            const data = await response.json();
                            
                            if (data.success) {
                                document.getElementById('loadingSpinner').classList.add('hidden');
                                document.getElementById('successMessage').classList.remove('hidden');
                                this.classList.add('hidden');
                            } else {
                                throw new Error(data.message || 'Ошибка при отправке');
                            }
                        } catch (error) {
                            console.error(error);
                            document.getElementById('loadingSpinner').classList.add('hidden');
                            document.getElementById('errorMessageText').textContent = error.message || 'Произошла ошибка. Пожалуйста, позвоните нам.';
                            document.getElementById('errorMessage').classList.remove('hidden');
                        }
                    });
                </script>
            </div>

    </div>
       <!-- Map Section (outside grid, full width) -->
     <section class="py-20 bg-gray-800">
            <div class="w-full px-4">
                <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 w-full">Как нас найти</h2>
