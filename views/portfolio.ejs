<div class="container mx-auto px-4 py-20">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 gold-accent">Портфолио ремонтов двигателей Mercedes-Benz</h2>
    
    <% if (portfolio && portfolio.length > 0) { %>
        <div class="grid md:grid-cols-3 gap-8">
            <% portfolio.forEach(function(item) { %>
                <div class="bg-gray-800 rounded-xl p-6 text-center card-hover">
                    <% if (item.images && item.images[0]) { %>
                        <img src="<%= item.images[0] %>" alt="<%= item.title %>" class="w-full h-48 object-cover rounded-lg mb-3">
                    <% } else { %>
                        <div class="bg-gray-700 h-48 rounded-lg mb-3 flex items-center justify-center">
                            <span class="text-gray-500 text-sm">Фото отсутствует</span>
                        </div>
                    <% } %>
                    
                    <h3 class="text-xl font-bold mb-2"><%= item.title %></h3>
                    <p class="text-gray-400 text-sm mb-3 line-clamp-3"><%= item.description %></p>
                    
                    <div class="flex justify-between items-center pt-3 border-t border-gray-700">
                        <span class="text-gold-accent font-semibold text-xs"><%= item.date %></span>
                        <a href="/contacts" class="inline-block border border-gold-accent text-gold-accent px-4 py-1.5 rounded-full hover:gold-bg hover:text-white transition text-sm">Записаться</a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <p class="text-center text-gray-400 py-20">Портфолио пока пусто</p>
    <% } %>
</div>
